# ==========================================
# JARVIS Environment Configuration Example
# ==========================================
# Copy this file to .env for backend/frontend configuration.
# DO NOT commit real secrets or production credentials.

# Application Environment (development, testing, production)
APP_ENV=development

# FastAPI Backend Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info

# Frontend Origin for CORS (Must be loopback / local-only)
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Configuration (Local-first)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=jarvis
MONGODB_TIMEOUT_MS=3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
